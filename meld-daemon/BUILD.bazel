"""
BUILD configuration for meld-daemon package.
This package provides the unified Meld daemon (meldd) — a single long-lived
process serving LSP and MCP channels from a shared SemanticModel.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

_COPTS = select({
    "@platforms//os:windows": ["/std:c++latest", "/W3", "/EHsc", "/Zc:__cplusplus"],
    "//conditions:default": ["-std=c++23", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
})

# SemanticModel — in-memory workspace representation with AST_RWLock
cc_library(
    name = "semantic_model",
    srcs = ["src/semantic_model.cpp"],
    hdrs = ["include/meld/daemon/semantic_model.hpp"],
    copts = _COPTS,
    includes = ["include"],
)

# DualVoiceFormatter — human + machine response formatting
cc_library(
    name = "dual_voice",
