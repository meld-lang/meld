// 44 — Const Values
// Top-level immutable values computed at definition time.
// Use val at module scope for constants.

val PI = 3.14159
val TAU = 6.28318
val MAX_RETRIES = 3
val APP_NAME = "meld-app"
val VERSION = "1.0.0"

fnc circle-area(radius: float) -> float {
    rtn PI * radius * radius
}

fnc circle-circumference(radius: float) -> float {
    rtn TAU * radius
}

fnc retry-with-limit(attempt: int) -> string {
    rtn when(attempt >= MAX_RETRIES)
        .then({ rtn "max retries exceeded" })
        .else({ rtn "attempt " + (attempt + 1) + " of " + MAX_RETRIES })
}

fnc main() -> () {
    println(APP_NAME + " v" + VERSION)
    println("PI = " + PI)
    println("area(r=5) = " + circle-area(5.0))
    println("circumference(r=5) = " + circle-circumference(5.0))

    println(retry-with-limit(0))
    println(retry-with-limit(1))
    println(retry-with-limit(3))
}
