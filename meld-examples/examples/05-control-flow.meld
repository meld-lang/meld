// 05 — Control Flow
// No if/else/while/for keywords. Everything is library functions.

fnc classify(n: int) -> string {
    rtn when(n > 0).then({ rtn "positive" })
        .when(n == 0).then({ rtn "zero" })
        .else({ rtn "negative" })
}

fnc main() -> () {
    // when/then/else — the primary conditional
    println("5: " + classify(5))
    println("0: " + classify(0))
    println("-3: " + classify(-3))

    // ifTrue/ifFalse — conditional execution
    val raining = true
    ifTrue(raining, { println("bring umbrella") })
    ifFalse(raining, { println("enjoy sunshine") })

    // Trailing lambda syntax
    val hot = true
    hot.ifTrue { println("drink water") }
}
