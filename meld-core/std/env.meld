// std/env.meld — Environment variables via effects

@uses(Env)
fnc env-get(name: string) -> Result {
    val value = Env.get(name)
    rtn when(value == "").then({ rtn Err("not set: " + name) }).else({ rtn Ok(value) })
}

@uses(Env)
fnc env-get-or(name: string, default: string) -> string {
    val value = Env.get(name)
    rtn when(value == "").then({ rtn default }).else({ rtn value })
}

@uses(Env)
fnc env-require(name: string) -> string {
    val value = Env.get(name)
    rtn when(value == "").then({ panic("Required env var not set: " + name) })
        .else({ rtn value })
}

@uses(Env)
fnc cwd() -> string { rtn Env.cwd() }

@uses(Env)
fnc home-dir() -> string { rtn Env.home() }
