// std/collections/flat_index_map.meld - open-addressed any -> int map.
//
// This is a value-specialized sibling of FlatMap for arena-backed data
// structures. It keeps integer values in an int array and returns misses as a
// caller-provided sentinel, avoiding boxed slot values and lookup records on
// hot paths such as cache reads.

struct FlatIndexMap {
    var ctrl: list
    var keys: list
    var values: list
    var hashes: list
    var capacity: int
    var size: int
    var deleted: int
}

fnc flat-index-map-max(a: int, b: int) -> int {
    rtn when(a > b).then({ rtn a }).else({ rtn b })
}

fnc flat-index-map-positive(value: int) -> int {
    rtn when(value < 0).then({ rtn 0 - value }).else({ rtn value })
}

fnc flat-index-map-next-power-of-two(target: int) -> int {
    val desired = flat-index-map-max(1, target)
    var power = 1
    loop-while({ rtn power < desired }, {
        power = power * 2
    })
    rtn power
}

fnc flat-index-map-create(expected-size: int) -> FlatIndexMap {
    val capacity = flat-index-map-next-power-of-two(flat-index-map-max(4, expected-size * 2))
    rtn FlatIndexMap {
        ctrl = iarr-new(capacity, 0),
        keys = arr-new(capacity, nil),
        values = iarr-new(capacity, 0),
        hashes = iarr-new(capacity, 0),
        capacity = capacity,
        size = 0,
        deleted = 0
    }
}

fnc flat-index-map-next-index(map: FlatIndexMap, index: int) -> int {
    rtn (index + 1) % map.capacity
}

fnc flat-index-map-start-index(map: FlatIndexMap, hash: int) -> int {
    rtn flat-index-map-positive(hash) % map.capacity
}

fnc flat-index-map-find-index-hashed(map: FlatIndexMap, key: any, hash: int) -> int {
    var index = flat-index-map-start-index(map, hash)
    var scanned = 0
    var found = -1
    var done = false

    loop-while({ rtn done == false && scanned < map.capacity }, {
        val ctrl = iarr-get(map.ctrl, index)
        when(ctrl == 0).then({
            done = true
        }).else({
            when(ctrl == 1 && iarr-get(map.hashes, index) == hash && value-eq(arr-get(map.keys, index), key)).then({
                found = index
                done = true
            }).else({
                index = flat-index-map-next-index(map, index)
                scanned = scanned + 1
            })
        })
    })

    rtn found
}

fnc flat-index-map-find-slot(map: FlatIndexMap, key: any, hash: int) -> int {
    var index = flat-index-map-start-index(map, hash)
    var first-deleted = -1
    var scanned = 0
    var found = -1
    var done = false

    loop-while({ rtn done == false && scanned < map.capacity }, {
        val ctrl = iarr-get(map.ctrl, index)
        when(ctrl == 0).then({
            found = when(first-deleted >= 0).then({ rtn first-deleted }).else({ rtn index })
            done = true
        }).else({
            when(ctrl == 2).then({
                when(first-deleted < 0).then({
                    first-deleted = index
                })
                index = flat-index-map-next-index(map, index)
                scanned = scanned + 1
            }).else({
                when(iarr-get(map.hashes, index) == hash && value-eq(arr-get(map.keys, index), key)).then({
                    found = index
                    done = true
                }).else({
                    index = flat-index-map-next-index(map, index)
                    scanned = scanned + 1
                })
            })
        })
    })
    rtn when(found >= 0).then({ rtn found }).else({
        rtn when(first-deleted >= 0).then({ rtn first-deleted }).else({ rtn -1 })
    })
}

fnc flat-index-map-put-hashed-no-grow(map: FlatIndexMap, key: any, value: int, hash: int) -> bool {
    val slot = flat-index-map-find-slot(map, key, hash)
    rtn when(slot < 0).then({ rtn false }).else({
        val ctrl = iarr-get(map.ctrl, slot)
        val inserted = ctrl != 1
        when(inserted).then({
            map.size = map.size + 1
            when(ctrl == 2).then({ map.deleted = flat-index-map-max(0, map.deleted - 1) })
        })
        iarr-set-mut(map.ctrl, slot, 1)
        arr-set-mut(map.keys, slot, key)
        iarr-set-mut(map.values, slot, value)
        iarr-set-mut(map.hashes, slot, hash)
        rtn inserted
    })
}

fnc flat-index-map-reinsert-all(map: FlatIndexMap, old-ctrl: list, old-keys: list, old-values: list, old-hashes: list, old-capacity: int, index: int) -> () {
    var cursor = index
    loop-while({ rtn cursor < old-capacity }, {
        when(iarr-get(old-ctrl, cursor) == 1).then({
            flat-index-map-put-hashed-no-grow(map, arr-get(old-keys, cursor), iarr-get(old-values, cursor), iarr-get(old-hashes, cursor))
        })
        cursor = cursor + 1
    })
}

fnc flat-index-map-rehash(map: FlatIndexMap, new-capacity: int) -> () {
    val old-ctrl = map.ctrl
    val old-keys = map.keys
    val old-values = map.values
    val old-hashes = map.hashes
    val old-capacity = map.capacity

    map.ctrl = iarr-new(new-capacity, 0)
    map.keys = arr-new(new-capacity, nil)
    map.values = iarr-new(new-capacity, 0)
    map.hashes = iarr-new(new-capacity, 0)
    map.capacity = new-capacity
    map.size = 0
    map.deleted = 0
    flat-index-map-reinsert-all(map, old-ctrl, old-keys, old-values, old-hashes, old-capacity, 0)
}

fnc flat-index-map-grow(map: FlatIndexMap) -> () {
    flat-index-map-rehash(map, flat-index-map-max(4, map.capacity * 2))
}

fnc flat-index-map-compact(map: FlatIndexMap) -> () {
    flat-index-map-rehash(map, map.capacity)
}

fnc flat-index-map-ensure-room(map: FlatIndexMap) -> () {
    when((map.size + map.deleted + 1) * 10 >= map.capacity * 7).then({
        when(map.deleted > map.size).then({
            flat-index-map-compact(map)
        }).else({
            flat-index-map-grow(map)
        })
    })
}

fnc flat-index-map-put-hashed(map: FlatIndexMap, key: any, value: int, hash: int) -> bool {
    flat-index-map-ensure-room(map)
    rtn flat-index-map-put-hashed-no-grow(map, key, value, hash)
}

fnc flat-index-map-put(map: FlatIndexMap, key: any, value: int) -> bool {
    rtn flat-index-map-put-hashed(map, key, value, hash-code(key))
}

fnc flat-index-map-get-hashed(map: FlatIndexMap, key: any, hash: int, missing: int) -> int {
    val index = flat-index-map-find-index-hashed(map, key, hash)
    rtn when(index >= 0).then({
        rtn iarr-get(map.values, index)
    }).else({ rtn missing })
}

fnc flat-index-map-get(map: FlatIndexMap, key: any, missing: int) -> int {
    rtn flat-index-map-get-hashed(map, key, hash-code(key), missing)
}

fnc flat-index-map-remove-hashed(map: FlatIndexMap, key: any, hash: int) -> bool {
    val index = flat-index-map-find-index-hashed(map, key, hash)
    rtn when(index >= 0).then({
        iarr-set-mut(map.ctrl, index, 2)
        arr-set-mut(map.keys, index, nil)
        iarr-set-mut(map.values, index, 0)
        iarr-set-mut(map.hashes, index, 0)
        map.size = flat-index-map-max(0, map.size - 1)
        map.deleted = map.deleted + 1
        rtn true
    }).else({ rtn false })
}

fnc flat-index-map-remove(map: FlatIndexMap, key: any) -> bool {
    rtn flat-index-map-remove-hashed(map, key, hash-code(key))
}

fnc flat-index-map-clear(map: FlatIndexMap) -> () {
    map.ctrl = iarr-new(map.capacity, 0)
    map.keys = arr-new(map.capacity, nil)
    map.values = iarr-new(map.capacity, 0)
    map.hashes = iarr-new(map.capacity, 0)
    map.size = 0
    map.deleted = 0
}
