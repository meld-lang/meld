"""
BUILD configuration for meld-manifest package.
This package provides the .meld manifest sidecar, binary tombstone,
cryptographic signing/verification, and SRT-based sandbox enforcement.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

_COPTS = select({
    "@platforms//os:windows": ["/std:c++latest", "/W3", "/EHsc", "/Zc:__cplusplus"],
    "//conditions:default": ["-std=c++23", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
})

# Core types — Effect enum, EffectBitmask, ResourceBounds, SymbolEffectEntry
cc_library(
    name = "core_types",
    hdrs = ["include/meld/manifest/core_types.hpp"],
    copts = _COPTS,
    includes = ["include"],
)

# Manifest — .meld sidecar serialization, code hashing, ManifestEmitter
cc_library(
    name = "manifest",
    srcs = ["src/manifest.cpp"],
    hdrs = ["include/meld/manifest/manifest.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":core_types",
        "@nlohmann_json//:json",
    ],
)

# Tombstone — .note.meld ELF/Mach-O section embedding and extraction
cc_library(
    name = "tombstone",
    srcs = ["src/tombstone.cpp"],
    hdrs = ["include/meld/manifest/tombstone.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        "@nlohmann_json//:json",
    ],
)

# BridgeRule — FFI @effect annotation enforcement
cc_library(
    name = "bridge_rule",
    srcs = ["src/bridge_rule.cpp"],
    hdrs = ["include/meld/manifest/bridge_rule.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":core_types",
    ],
)

# EffectElision — whole-binary call-graph effect stripping
cc_library(
    name = "effect_elision",
    srcs = ["src/effect_elision.cpp"],
    hdrs = ["include/meld/manifest/effect_elision.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":manifest",
    ],
)

# SigningEngine — traditional + Sigstore cryptographic signing
cc_library(
    name = "signing",
    srcs = ["src/signing.cpp"],
    hdrs = ["include/meld/manifest/signing.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":manifest",
        ":tombstone",
    ],
)

# Verifier — offline + online audit verification modes
cc_library(
    name = "verifier",
    srcs = ["src/verifier.cpp"],
    hdrs = ["include/meld/manifest/verifier.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":manifest",
        ":signing",
        ":tombstone",
    ],
)

# IMA integration — optional hardware-level integrity
cc_library(
    name = "ima_integration",
    srcs = ["src/ima_integration.cpp"],
    hdrs = ["include/meld/manifest/ima_integration.hpp"],
    copts = _COPTS,
    includes = ["include"],
)

# MdebugSidecar — .mdebug debug sidecar serialization and file I/O
cc_library(
    name = "mdebug_sidecar",
    srcs = ["src/mdebug_sidecar.cpp"],
    hdrs = ["include/meld/manifest/mdebug_sidecar.hpp"],
    copts = _COPTS,
    includes = ["include"],
)

# SandboxProvider — abstract interface + PassthroughProvider
cc_library(
    name = "sandbox_provider",
    srcs = ["src/sandbox_provider.cpp"],
    hdrs = ["include/meld/manifest/sandbox_provider.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":core_types",
    ],
)

# MeldSRTProvider — SRT-backed sandbox with effect-to-policy mapping
cc_library(
    name = "srt_provider",
    srcs = ["src/srt_provider.cpp"],
    hdrs = ["include/meld/manifest/srt_provider.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":sandbox_provider",
        "@nlohmann_json//:json",
    ],
)

# PolicyLifecycleManager — ephemeral srt-settings.json lifecycle
cc_library(
    name = "policy_lifecycle",
    srcs = ["src/policy_lifecycle.cpp"],
    hdrs = ["include/meld/manifest/policy_lifecycle.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":sandbox_provider",
        ":srt_provider",
    ],
)

# BuildSandbox — build-time isolation for first/third-party targets
cc_library(
    name = "build_sandbox",
    srcs = ["src/build_sandbox.cpp"],
    hdrs = ["include/meld/manifest/build_sandbox.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":sandbox_provider",
