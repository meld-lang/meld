    name = "mcp_sandbox",
    srcs = ["src/mcp_sandbox.cpp"],
    hdrs = ["include/meld/manifest/mcp_sandbox.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":manifest",
        ":sandbox_provider",
