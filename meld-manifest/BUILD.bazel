)

# SandboxDiagnostics — structured diagnostics and observability
cc_library(
    name = "sandbox_diagnostics",
    srcs = ["src/sandbox_diagnostics.cpp"],
    hdrs = ["include/meld/manifest/sandbox_diagnostics.hpp"],
    copts = _COPTS,
    includes = ["include"],
    deps = [
        ":core_types",
    ],
)

# meld-sign CLI binary
cc_binary(
    name = "meld-sign",
    srcs = ["src/meld_sign_main.cpp"],
    copts = _COPTS,
    deps = [
        ":manifest",
        ":signing",
        ":tombstone",
    ],
)

